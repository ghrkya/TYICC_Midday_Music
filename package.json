{
  "name": "tyicc-midday-music",
  "version": "3.0.0",
  "description": "TYICC午间悦听 - 校园广播站智能音频工作流系统",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite & timeout /t 3 /nobreak >nul & npx electron src/main/main.js",
    "dev:electron": "npx electron src/main/main.js",
    "build": "vite build && node -e \"require('fs').cpSync('static','dist/static',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "dist:win": "set HTTP_PROXY=&& set http_proxy=&& set HTTPS_PROXY=&& set https_proxy=&& electron-builder --win --x64",
    "dist:mac": "set HTTP_PROXY=&& set http_proxy=&& electron-builder --mac --x64"
  },
  "keywords": [
    "broadcast",
    "audio",
    "bilibili",
    "school"
  ],
  "author": "安舒阳",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.tyicc.midday-music",
    "productName": "TYICC午间悦听",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "static/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "static/",
        "to": "static/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "static/TYICC午间悦听logo_V1.5_画板 1.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "static/TYICC午间悦听logo_V1.5_画板 1.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.6.0",
    "antd": "^6.4.3",
    "fluent-ffmpeg": "^2.1.3",
    "init": "^0.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
